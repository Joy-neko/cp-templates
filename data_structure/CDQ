#include <bits/stdc++.h>

using i64 = long long;
using u64 = unsigned long long;
using u32 = unsigned int;
 
using i128 = __int128;
using u128 = unsigned __int128;

constexpr i64 inf = std::numeric_limits<i64>::max();

class Fenwick {
public:
    int n;
    std::vector<int> tr;
    Fenwick(int _n) {
        n = _n;
        for(int i = 0; i <= n + 5; i ++) tr.push_back(0);
    }

    int lowbit(int x) {
        return x & (-x);
    }

    void modify(int x, int v) {
        while(x <= n) {
            tr[x] += v;
            x += lowbit(x);
        }
    }

    int query(int x) {
        int ans = 0;
        while(x > 0) {
            ans += tr[x];
            x -= lowbit(x);
        }
        return ans;
    }
};

struct node {
    int id, a, b, c;
};


void solve() {
    int n, k;
    std::cin >> n >> k;
    std::vector<node> a(n + 1);
    Fenwick tr(k);
    for(int i = 1; i <= n; i ++) {
        a[i].id = i;
        std::cin >> a[i].a >> a[i].b >> a[i].c;
    }
    std::sort(a.begin() + 1, a.begin() + 1 + n, [&](node x, node y) {
        if(x.a == y.a) {
            if(x.b == y.b) return x.c < y.c;
            else return x.b < y.b;
        }
        return x.a < y.a;
    });

    std::vector<int> f(n + 1, 0), ans(n + 1, 0);

    auto merge = [&](int l, int m, int r) -> void {
        int p1, p2;
        for(p1 = l - 1, p2 = m + 1; p2 <= r; p2 ++) {
            while(p1 + 1 <= m && a[p1 + 1].b <= a[p2].b) {
                p1 ++;
                tr.modify(a[p1].c, 1);
            }
            f[a[p2].id] += tr.query(a[p2].c);
        }
        for(int i = l; i <= p1; i ++) {
            tr.modify(a[i].c, -1);
        }
        std::sort(a.begin() + l, a.begin() + r + 1, [&](node x, node y) {
            if(x.b == y.b) return x.c < y.c;
            return x.b < y.b;
        });
    };

    auto cdq = [&](auto& self, int l, int r) -> void {
        if(l == r) return;
        int mid = (l + r) >> 1;
        self(self, l, mid);
        self(self, mid + 1, r);
        merge(l, mid, r);
    };

    for(int l = 1, r = 1; l <= n; l = ++r) {
        while(r + 1 <= n && a[l].a == a[r + 1].a && a[l].b == a[r + 1].b && a[l].c == a[r + 1].c) r ++;
        for(int i = l; i <= r; i ++) {
            f[a[i].id] += r - i;
        }
    }

    cdq(cdq, 1, n);

    for(int i = 1; i <= n; i ++) ans[f[i]] ++;
    for(int i = 0; i < n; i ++) std::cout << ans[i] << "\n";
}	


int main() {
	std::ios::sync_with_stdio(false);
	std::cin.tie(nullptr);
	int t = 1;
    //std::cin >> t;
	while(t --) solve();

	return 0;
}
