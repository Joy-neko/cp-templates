#include <bits/stdc++.h>

using i64 = long long;
using u64 = unsigned long long;
using u32 = unsigned int;
 
using i128 = __int128;
using u128 = unsigned __int128;

class DSU {
public:
	i64 n;
	std::vector<i64> fa, dis;
	DSU(i64 _n) {
		n = _n;
		for(int i = 0; i <= n + 5; i ++) fa.push_back(i);
		for(int i = 0; i <= n + 5; i ++) dis.push_back(0);
	}
	
	i64 find(int x) {
		if(fa[x] == x) return x;
		int tmp = fa[x];
		fa[x] = find(fa[x]);
		dis[x] += dis[tmp];
		return fa[x];
	}
	//v + dis[second] - dis[first]
	void merge(int a, int b, i64 v) {
		int ra = find(a), rb = find(b);
		if(ra == rb) return;
		fa[ra] = rb;
		dis[ra] = v + dis[b] - dis[a];
	}
	//dis[first] - dis[second]
	i64 query(int a, int b) {
		if(find(a) != find(b)) return 4e18;
		return dis[a] - dis[b];
	}
};
