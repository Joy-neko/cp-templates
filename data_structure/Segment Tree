template<class T>
struct SegTree {
    int n;
    std::vector<T> sum, tag;

    SegTree(int n) {
        init(n);
    }

    SegTree(const std::vector<T>& a) {
        init((int)a.size() - 1);
        build(1, 1, n, a);
    }

    void init(int n) {
        this->n = n;
        sum.assign(4 * n + 5, T());
        tag.assign(4 * n + 5, T());
    }

    void pushup(int p) {
        sum[p] = sum[p << 1] + sum[p << 1 | 1];
    }

    void apply(int p, int l, int r, T x) {
        sum[p] += x * (r - l + 1);
        tag[p] += x;
    }

    void pushdown(int p, int l, int r) {
        if(tag[p] == T()) return;

        int mid = (l + r) >> 1;
        apply(p << 1, l, mid, tag[p]);
        apply(p << 1 | 1, mid + 1, r, tag[p]);
        tag[p] = T();
    }

    void build(int p, int l, int r, const std::vector<T>& a) {
        if(l == r) {
            sum[p] = a[l];
            return;
        }

        int mid = (l + r) >> 1;
        build(p << 1, l, mid, a);
        build(p << 1 | 1, mid + 1, r, a);
        pushup(p);
    }

    void add(int p, int l, int r, int ql, int qr, T x) {
        if(ql <= l && r <= qr) {
            apply(p, l, r, x);
            return;
        }

        pushdown(p, l, r);

        int mid = (l + r) >> 1;
        if(ql <= mid) add(p << 1, l, mid, ql, qr, x);
        if(qr > mid) add(p << 1 | 1, mid + 1, r, ql, qr, x);

        pushup(p);
    }

    T query(int p, int l, int r, int ql, int qr) {
        if(ql <= l && r <= qr) {
            return sum[p];
        }

        pushdown(p, l, r);

        int mid = (l + r) >> 1;
        T res = T();

        if(ql <= mid) res += query(p << 1, l, mid, ql, qr);
        if(qr > mid) res += query(p << 1 | 1, mid + 1, r, ql, qr);

        return res;
    }

    void add(int l, int r, T x) {
        add(1, 1, n, l, r, x);
    }

    T query(int l, int r) {
        return query(1, 1, n, l, r);
    }
};
